# WatchCrawler server settings. setup.sh / setup.ps1 fill these in for you.
# For Docker: copy to ../.env (repo root, next to docker-compose.yml) and edit.
# Never commit the real file.

# Which LLM writes the jokes: anthropic or deepseek
LLM_PROVIDER=anthropic

# Your own API key for that provider (only the one you use is needed)
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Random secret the watch sends with every request (setup generates it; the watch build bakes it in)
WATCH_SHARED_KEY=

# How much API credit you bought, in USD. Used to warn you before it runs out.
# Anthropic keys can't read their own balance, so this is how the server knows. Optional.
CREDIT_BALANCE_USD=

# About how many notifications a day you expect - only for the cost estimate before real usage exists
Llm__EstimatedEventsPerDay=10

# Optional: your own ntfy topic URL (e.g. https://ntfy.sh/some-long-random-name) to get
# "top up your credit" pushes on your phone too, not only on the watch
USER_NTFY_URL=

# Error reports (no keys, no activity data) go to the WatchCrawler developer to help fix problems.
# Set to false to turn them off.
REPORT_ERRORS=true

# ---- Hosted mode (one server for every store user; see README.md "Hosted mode") ----
# Off by default. With HOSTED=true every watch must send X-Device-Id, gets a free trial, then needs
# a one-time unlock (PayPal on the server's /unlock page, or a coupon) for AI narration.
HOSTED=false
# The unlock page address as shown on the watch (short, no https://). Required when hosted.
HOSTED_UNLOCK_URL=
# Secret for the /admin endpoints (and /usage when hosted). Required when hosted.
ADMIN_KEY=
# Payments: pick ONE provider (or neither = coupon-only unlocks).
# Recommended: Lemon Squeezy (merchant of record: they collect tax, handle refunds, pay you out; no
# business account needed). The product's "Buy" link, and the signing secret of a webhook pointed at
# https://<server>/webhook/lemonsqueezy for the order_created event.
LEMONSQUEEZY_CHECKOUT_URL=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Alternative: PayPal REST app (developer.paypal.com; needs a PayPal Business account to go live).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_ENV=sandbox
# Business rules (defaults shown)
HOSTED_PRICE_USD=7.99
HOSTED_TRIAL_DAYS=7
HOSTED_LICENSE_YEARS=3
HOSTED_AI_PER_DAY=6
# 0 = no cap. Past this month's LLM spend every watch gets built-in lines until next month.
HOSTED_MONTHLY_BUDGET_USD=0

# When day events may fire (hours 0-23, watch local time)
DAY_QUIET_FROM=23
DAY_QUIET_TO=7
DAY_MAX_PER_DAY=10
DAY_IDLE_HOUR=22
DAY_GOAL_HOUR=21
