# WatchCrawler server settings. setup.sh / setup.ps1 fill these in for you.
# For Docker: copy to ../.env (repo root, next to docker-compose.yml) and edit.
# Never commit the real file.

# Which LLM writes the jokes: anthropic or deepseek
LLM_PROVIDER=anthropic

# Your own API key for that provider (only the one you use is needed)
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Random secret the watch sends with every request (setup generates it; the watch build bakes it in)
WATCH_SHARED_KEY=

# How much API credit you bought, in USD. Used to warn you before it runs out.
# Anthropic keys can't read their own balance, so this is how the server knows. Optional.
CREDIT_BALANCE_USD=

# About how many notifications a day you expect - only for the cost estimate before real usage exists
Llm__EstimatedEventsPerDay=10

# Optional: your own ntfy topic URL (e.g. https://ntfy.sh/some-long-random-name) to get
# "top up your credit" pushes on your phone too, not only on the watch
USER_NTFY_URL=

# Error reports (no keys, no activity data) go to the WatchCrawler developer to help fix problems.
# Set to false to turn them off.
REPORT_ERRORS=true

# When day events may fire (hours 0-23, watch local time)
DAY_QUIET_FROM=23
DAY_QUIET_TO=7
DAY_MAX_PER_DAY=10
DAY_IDLE_HOUR=22
DAY_GOAL_HOUR=21
