<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GarminAchievements</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Update="sample-events.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Tests/ has its own .csproj; without this, the implicit **/*.cs glob
       here also picks up the test files (which reference xunit, not
       referenced by this project) and fails the build. -->
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <Compile Remove="Tests/**/obj/**" />
  </ItemGroup>

</Project>
