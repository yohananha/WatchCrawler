{
  "Urls": "http://0.0.0.0:5080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Llm": {
    // Which provider the API uses. Must match a key under "Providers".
    "ActiveProvider": "Anthropic",

    "Language": "English",
    "AllowProfanity": false,
    "MaxTitleChars": 40,
    "MaxTextChars": 120,
    "MaxRewardChars": 70,
    "Temperature": 1.0,
    "RecentHistorySize": 10,
    "EstimatedEventsPerDay": 10,

    "Providers": {
      "Anthropic": {
        "Kind": "anthropic",
        "BaseUrl": "https://api.anthropic.com",
        "Model": "claude-haiku-4-5",
        "ApiKeyEnv": "ANTHROPIC_API_KEY",
        "InputPricePerM": 1.0,
        "OutputPricePerM": 5.0
      },
      "DeepSeek": {
        "Kind": "openai",
        "BaseUrl": "https://api.deepseek.com",
        "Model": "deepseek-flash",
        "ApiKeyEnv": "DEEPSEEK_API_KEY",
        // deepseek-flash is a reasoning model; with thinking on it burns max_tokens and returns empty content.
        "DisableThinking": true,
        // Peak-hour prices; off-peak is half.
        "InputPricePerM": 0.30,
        "OutputPricePerM": 1.20
      },
      "OpenRouter": {
        "Kind": "openai",
        "BaseUrl": "https://openrouter.ai/api/v1",
        // Pick any model ID from openrouter.ai/models and update the prices.
        "Model": "PUT-MODEL-ID-HERE",
        "ApiKeyEnv": "OPENROUTER_API_KEY",
        "InputPricePerM": 0,
        "OutputPricePerM": 0
      }
    }
  }
}
