{
  "Urls": "http://0.0.0.0:5080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Llm": {
    // Which provider the API uses. Must match a key under "Providers".
    "ActiveProvider": "Anthropic",

    "Language": "English",
    "AllowProfanity": false,
    "MaxTitleChars": 40,
    "MaxTextChars": 120,
    "MaxRewardChars": 70,
    "Temperature": 1.0,
    "RecentHistorySize": 10,
    // Used for the monthly cost estimate until there is real usage (setup sets it with Llm__EstimatedEventsPerDay).
    "EstimatedEventsPerDay": 10,

    "Providers": {
      "Anthropic": {
        "Kind": "anthropic",
        "BaseUrl": "https://api.anthropic.com",
        "Model": "claude-haiku-4-5",
        "ApiKeyEnv": "ANTHROPIC_API_KEY",
        "InputPricePerM": 1.0,
        "OutputPricePerM": 5.0,
        // Typical tokens per achievement (system prompt + event + recent history / short JSON answer).
        "AvgInputTokens": 1200,
        "AvgOutputTokens": 80
      },
      "DeepSeek": {
        "Kind": "openai",
        "BaseUrl": "https://api.deepseek.com",
        "Model": "deepseek-flash",
        "ApiKeyEnv": "DEEPSEEK_API_KEY",
        // deepseek-flash is a reasoning model; with thinking on it burns max_tokens and returns empty content.
        "DisableThinking": true,
        // Peak-hour prices; off-peak is half.
        "InputPricePerM": 0.30,
        "OutputPricePerM": 1.20,
        "AvgInputTokens": 1200,
        "AvgOutputTokens": 80
      },
      "OpenRouter": {
        "Kind": "openai",
        "BaseUrl": "https://openrouter.ai/api/v1",
        // Pick any model ID from openrouter.ai/models and update the prices.
        "Model": "PUT-MODEL-ID-HERE",
        "ApiKeyEnv": "OPENROUTER_API_KEY",
        "InputPricePerM": 0,
        "OutputPricePerM": 0
      }
    }
  },
  // Failure reports from every WatchCrawler server go to the developer (see README "What is sent").
  // Users opt out with REPORT_ERRORS=false. Subscribe to the topic in the ntfy app to receive them.
  "Reporting": {
    "NtfyUrl": "https://ntfy.sh/watchcrawler-7ea5a2366814f886185b",
    "DigestEmail": "yohananha@gmail.com"
  }
}
