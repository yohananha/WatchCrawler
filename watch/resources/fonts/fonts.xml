<fonts xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <!-- Press Start 2P (OFL), uppercase + digits + basic punctuation, one bitmap
         font per size since Connect IQ can't scale text. Generated by
         watch/tools/make_bmfont.py from the source .ttf - see that script and
         watch/source/anim/ for how these are used. Sizes bumped ~15-20% from
         the original 14/20/26/32/40/48/18 set (user feedback: smallest text
         was too small; bumped the whole hierarchy proportionally rather than
         just the smallest, to keep title > body sizing relationships sane). -->
    <font id="Px16" filename="px16.fnt" />
    <font id="Px24" filename="px24.fnt" />
    <font id="Px30" filename="px30.fnt" />
    <font id="Px38" filename="px38.fnt" />
    <font id="Px46" filename="px46.fnt" />
    <font id="Px56" filename="px56.fnt" />
    <!-- Silkscreen (OFL), mixed case, for typed commentary/reward lines.
         Sk18 is the fallback for long commentary that would otherwise wrap
         past the safe vertical zone at Sk22 - see AchievementView's
         fitCommentaryFont. -->
    <font id="Sk22" filename="sk22.fnt" />
    <font id="Sk18" filename="sk18.fnt" />
</fonts>
