    <font id="Px14" filename="px14.fnt" />
    <font id="Px20" filename="px20.fnt" />
    <font id="Px26" filename="px26.fnt" />
    <font id="Px32" filename="px32.fnt" />
    <font id="Px40" filename="px40.fnt" />
    <font id="Px48" filename="px48.fnt" />
    <!-- Silkscreen (OFL), mixed case, for typed commentary/reward lines. -->
    <font id="Sk18" filename="sk18.fnt" />
</fonts>
